# Variables d'environnement du bot — copiez ce fichier en `.env` pour le
# développement local, et recopiez les valeurs dans Railway → Variables.
#
# ⚠️ Ne commitez jamais votre vrai token.

# --- Obligatoire ----------------------------------------------------------
# Token du bot Discord (https://discord.com/developers/applications → Bot → Token)
DISCORD_TOKEN=remplacez-moi

# --- Facultatif -----------------------------------------------------------
# Domaine Vinted : fr, be, nl, de, at, es, it, pt, pl, cz, sk, lt, lv, se,
# fi, dk, ro, hu, gr, lu, ie, co.uk, com
VINTED_DOMAIN=fr

# Répertoire de persistance. Sur Railway : créez un volume monté sur /data
# et mettez DATA_DIR=/data (sinon l'état est perdu à chaque redéploiement).
DATA_DIR=data

# Intervalle par défaut des veilles (secondes, min 30)
VEILLE_INTERVALLE_DEFAUT=60

# Intervalle par défaut des suivis d'articles (secondes, min 30)
SUIVI_INTERVALLE_DEFAUT=300

# Nombre d'annonces lues par cycle de veille (max 96)
VEILLE_PAGE_SIZE=24

# Historique d'annonces déjà vues conservé par veille
VEILLE_HISTORIQUE_MAX=1500

# Résultats max d'une /recherche
RECHERCHE_MAX_AFFICHEE=5

# Première vérification immédiate à la création d'une veille (1/0)
VEILLE_SCAN_INITIAL=1

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
